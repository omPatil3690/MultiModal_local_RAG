# ==============================================================================
# Backend Environment Configuration Example
# ==============================================================================
# Copy this file to backend/.env: `cp .env.example .env`

# Vision-Language Model used for OCR on PDFs and image captioning/OCR
# Pulled in Ollama with: `ollama pull qwen2.5vl:7b`
# Default: qwen2.5vl:7b
OLLAMA_VL_MODEL=qwen2.5vl:7b

# Text LLM used for query hints/expansion and grounded answering with citations
# Pulled in Ollama with: `ollama pull qwen3:8b`
# Default: qwen3:8b
OLLAMA_TEXT_MODEL=qwen3:8b

# Ollama API Base URL (Ollama default port is 11434)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Server Host & Port
HOST=127.0.0.1
PORT=8000
