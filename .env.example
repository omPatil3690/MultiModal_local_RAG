# ==============================================================================
# Local Multimodal RAG - Root Environment Configuration Example
# ==============================================================================
# Duplicate this file to .env or configure backend/.env and frontend/.env

# ------------------------------------------------------------------------------
# Backend Configuration (FastAPI & Ollama / Local Models)
# ------------------------------------------------------------------------------
# Vision-Language Model used for OCR on PDFs and image descriptions
# Pulled via: `ollama pull qwen2.5vl:7b`
OLLAMA_VL_MODEL=qwen2.5vl:7b

# Text LLM used for query planning / hint generation and final grounded responses
# Pulled via: `ollama pull qwen3:8b`
OLLAMA_TEXT_MODEL=qwen3:8b

# Ollama Service URL (default local instance)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Backend Host and Port
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# ------------------------------------------------------------------------------
# Frontend Configuration (Next.js)
# ------------------------------------------------------------------------------
# URL pointing to the FastAPI backend API
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
